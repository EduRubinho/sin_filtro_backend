# backend/.env
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/sin_filtro
PORT=3000
NODE_ENV=development
# Generar una vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ATTENDANCE_PIN_SECRET=

# Opcional local; en Render usar el bucket privado de Supabase. Solo backend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=activity-photos
